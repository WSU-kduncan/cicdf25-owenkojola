[Unit]
Description=Webhook listener for Project 5 container refresh
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/webhook -ip 0.0.0.0 -port 9000 -verbose -hooks /opt/deployment/hooks.json
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
